NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://nexoffice:nexoffice@localhost:5432/nexoffice
DATABASE_SSL=false
ALLOWED_ORIGINS=http://localhost:5173
WEB_APP_URL=http://localhost:5173
SESSION_TTL_DAYS=30

# Internal platform/API integration. Keep server-side only.
NEXOFFICE_INTERNAL_KEY=

# Comma-separated emails allowed to use the private /adm intelligence portal.
# Keep server-side only. Example: founder@example.com,ops@example.com
NEXOFFICE_ADMIN_EMAILS=

# External provider side effects are OFF unless explicitly enabled in production.
NEXOFFICE_EXTERNAL_ACTIONS=false

# Optional AI layer for future agent execution.
OPENAI_API_KEY=

# AV capability adapters. Never expose API keys to the browser.
DOCWALLET_BASE_URL=https://docwallet-backend.onrender.com
DOCWALLET_PUBLIC_URL=https://docwallet.netlify.app
# Shared service secret used by the DocWallet NexOffice bridge. Preferred name:
DOCWALLET_SERVICE_KEY=
# Backward-compatible fallback. Keep empty when DOCWALLET_SERVICE_KEY is used.
DOCWALLET_API_KEY=
DOCWALLET_ACTION_PATH=
SMARTBOTS_BASE_URL=
SMARTBOTS_API_KEY=
SMARTBOTS_SEND_PATH=
SMARTBOTS_AUTH_HEADER=
STAFF_BASE_URL=
STAFF_API_KEY=
STAFF_ACTION_PATH=
STAFF_AUTH_HEADER=
NEXTGEN_BASE_URL=https://api.nextgenassets.com.br
NEXTGEN_API_KEY=
MODO_BASE_URL=https://modo-api-3m10.onrender.com
MODO_API_KEY=
MODO_ACTION_PATH=
MODO_AUTH_HEADER=
TAXAGENT_BASE_URL=
TAXAGENT_API_KEY=
TAXAGENT_INVOICE_PATH=
TAXAGENT_AUTH_HEADER=

# Future Nexa Business bridge. Keep every flag false until the Nexa BaaS
# provider has been contracted, mapped and homologated. Read availability does
# not automatically authorize account creation or payments.
NEXA_BUSINESS_BASE_URL=https://nexa-backend-p2u0.onrender.com
NEXA_BUSINESS_SERVICE_KEY=
NEXOFFICE_NEXA_BUSINESS_ENABLED=false
NEXOFFICE_NEXA_BUSINESS_WRITES_ENABLED=false
NEXOFFICE_NEXA_BUSINESS_ACCOUNT_PROVISIONING_ENABLED=false
NEXOFFICE_NEXA_BUSINESS_PAYMENTS_ENABLED=false

# Optional cost estimates, in BRL cents per successful external operation.
# Leave empty until provider/unit economics are confirmed.
DOCWALLET_OPERATION_COST_MINOR=
SMARTBOTS_MESSAGE_COST_MINOR=
STAFF_OPERATION_COST_MINOR=
NEXTGEN_CHARGE_COST_MINOR=
MODO_OPERATION_COST_MINOR=
TAXAGENT_OPERATION_COST_MINOR=
NEXA_BUSINESS_OPERATION_COST_MINOR=

# Frontend (copy into apps/web/.env for local development)
VITE_API_URL=http://localhost:4000
