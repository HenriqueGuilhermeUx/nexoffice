# Nexa PF production service — reference only; NEVER deploy this file directly.
# Do not insert real credentials in GitHub. Configure secrets inside the final
# dedicated PF-only Render service after legal, API, security and DB reviews.
NEXA_LIFEOS_ENV=production
NODE_ENV=production
NEXA_LIFEOS_PROD_RELEASE_APPROVED=false
NEXA_LIFEOS_PUBLIC_SIGNUP_ENABLED=false
NEXOFFICE_DATABASE_SCOPE=nexa-lifeos-prod
NEXOFFICE_EXTERNAL_ACTIONS=false
NEXOFFICE_INTELLIGENCE_DAILY_ENGINE=false
AUTO_MIGRATE=false
NEXA_LIFEOS_DB_TLS_STRICT=true
NEXA_LIFEOS_DISABLE_DEMO_SEED=true
ALLOWED_ORIGINS=https://trynexa.com.br
NEXA_LIFEOS_API_ORIGIN=https://api-life.trynexa.com.br
VITE_NEXA_LIFEOS_API_URL=https://api-life.trynexa.com.br
VITE_NEXA_LIFEOS_PUBLIC=true
VITE_NEXA_LIFEOS_BUILD_PROBE=false
NEXA_LIFEOS_ALLOW_WALLET_TOKEN_BRIDGE=false
NEXA_LIFEOS_ALLOW_PRIVY_CREATE_WALLET=false
SESSION_TTL_DAYS=7
NEXA_LIFEOS_NEON_PROJECT_ID=REPLACE_WITH_NEW_PROJECT_ID
NEXA_LIFEOS_DB_HOST=REPLACE_WITH_NEW_PRODUCTION_NEON_HOST
DATABASE_URL=REPLACE_WITH_NEW_SEPARATE_PROD_DB_URL_SSLMODE_VERIFY_FULL
# Preview invite hashes, allowed test emails, preview flags MUST NOT be present.
# API/DB service, DNS and dedicated prod server are not yet provisioned.
