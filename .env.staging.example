# NexOffice staging only. Do not reuse another venture database or credentials.
NEXOFFICE_ENV=staging
NODE_ENV=production
PORT=4000

# Must be a dedicated NexOffice staging PostgreSQL database.
NEXOFFICE_DATABASE_SCOPE=nexoffice-staging
DATABASE_URL=postgresql://USER:PASSWORD@DEDICATED_NEXOFFICE_STAGING_HOST:5432/nexoffice_staging
DATABASE_SSL=true

# Staging web origin. Do not use wildcard CORS.
WEB_APP_URL=https://staging.nexoffice.example
ALLOWED_ORIGINS=https://staging.nexoffice.example
SESSION_TTL_DAYS=30

# Generate a strong server-side value (32+ chars). Never commit the real value.
NEXOFFICE_INTERNAL_KEY=

# Mandatory staging safety lock until controlled validation is explicitly completed.
NEXOFFICE_EXTERNAL_ACTIONS=false

# Capability runtimes are optional in the first staging. Keep absent until each bridge is configured.
DOCWALLET_BASE_URL=
DOCWALLET_PUBLIC_URL=
DOCWALLET_SERVICE_KEY=
SMARTBOTS_BASE_URL=
SMARTBOTS_API_KEY=
STAFF_BASE_URL=
STAFF_API_KEY=
NEXTGEN_BASE_URL=
NEXTGEN_API_KEY=
MODO_BASE_URL=
MODO_API_KEY=
TAXAGENT_BASE_URL=
TAXAGENT_API_KEY=

# Cost estimates remain empty until provider economics are confirmed.
DOCWALLET_OPERATION_COST_MINOR=
SMARTBOTS_MESSAGE_COST_MINOR=
STAFF_OPERATION_COST_MINOR=
NEXTGEN_CHARGE_COST_MINOR=
MODO_OPERATION_COST_MINOR=
TAXAGENT_OPERATION_COST_MINOR=

# Frontend build variable.
VITE_API_URL=https://api-staging.nexoffice.example
